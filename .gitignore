# --- Terraform ---
# Downloaded provider plugins (~60 MB, rebuilt by `terraform init`)
.terraform/

# Infrastructure state: contains credentials in plain text
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Actual variable values, including the Proxmox API token
*.tfvars
*.tfvars.json
# ...but the anonymized template stays under version control
!*.tfvars.example

# .terraform.lock.hcl is DELIBERATELY committed: it pins provider checksums
# and guarantees an identical rebuild.

# --- Secrets and access ---
# SSH keys live outside the repository (~/.ssh/homelab, see spec §8.1).
# These rules are a safety net against an accidental copy.
*.pem
*.key
id_rsa*
id_ed25519*
!*.pub

# Cluster access
kubeconfig
kubeconfig-*
*.kubeconfig
.kube/

# Files decrypted by SOPS, once GitOps is in place
*.dec.yaml
*.dec.yml

# --- Ansible ---
*.retry
ansible/collections/
.vault_pass
# An encrypted vault would be safe to commit, but the same safety net applies:
# one forgotten --encrypt and the password is in the history.
vault.yml
vault.yaml

# --- Working documents ---
# Design specifications, not versioned (user decision)
docs/superpowers/

# --- System and editors ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# --- Local agent tooling ---
.claude/settings.local.json
.usage/
