{{ ansible_managed | comment }}
# Storage-focused view of the database: the two gauges that answer "is the
# storage filling up" — WAL on disk and per-database size — plus the up flag.
# The grafana_dashboard label is what the kube-prometheus-stack sidecar
# watches. NFS enforces no capacity, so these graphs are the watch, not a
# guardrail.
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-storage-dashboard
  namespace: {{ postgres_dashboard_namespace }}
  labels:
    grafana_dashboard: "1"
data:
  postgres-storage.json: |
    {
      "title": "PostgreSQL — {{ postgres_cluster_name }}",
      "uid": "cnpg-{{ postgres_cluster_name }}",
      "tags": ["cloudnative-pg"],
      "schemaVersion": 39,
      "editable": true,
      "graphTooltip": 1,
      "time": { "from": "now-24h", "to": "now" },
      "templating": {
        "list": [
          {
            "name": "datasource",
            "type": "datasource",
            "query": "prometheus",
            "label": "Datasource"
          }
        ]
      },
      "panels": [
        {
          "type": "stat",
          "title": "PostgreSQL up",
          "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "targets": [
            {
              "expr": "cnpg_collector_up{cluster=\"{{ postgres_cluster_name }}\"}",
              "legendFormat": "up"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "WAL on disk",
          "description": "Segments in pg_wal. Growth without a matching write load means a stuck archive or replication slot.",
          "gridPos": { "h": 8, "w": 20, "x": 4, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "targets": [
            {
              "expr": "cnpg_collector_pg_wal{value=\"size\"}",
              "legendFormat": "pg_wal"
            }
          ],
          "fieldConfig": {
            "defaults": { "unit": "bytes" },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "Database size",
          "description": "Per-database size from pg_database_size. The real ceiling is the storage VM's data disk, shared by every claim on the export.",
          "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "targets": [
            {
              "expr": "cnpg_pg_database_size_bytes",
              "legendFormat": {{ "{{datname}}" | tojson }}
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "custom": { "fillOpacity": 0 }
            },
            "overrides": []
          }
        }
      ]
    }
