; Everything produced here is consumed by Linux: Terraform on the Proxmox host,
; cloud-init inside the guests, Ansible, Kubernetes manifests. CRLF reaches
; those parsers silently and fails without a useful error, so normalize at the
; editor level. .gitattributes enforces the same rule at commit time.

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

; HCL: `terraform fmt` is the authority. These values match what it emits.
[*.{tf,tfvars,hcl}]
indent_size = 2

; YAML forbids tabs in indentation entirely.
[*.{yaml,yml}]
indent_size = 2

; Shell scripts run on the hypervisor and inside the guests.
[*.sh]
indent_size = 2

; Markdown: two trailing spaces are a hard line break, so keep them.
[*.md]
trim_trailing_whitespace = false

; Generated by Terraform, never edited by hand.
[.terraform.lock.hcl]
indent_size = 2

; Makefile syntax requires literal tabs for recipe lines.
[Makefile]
indent_style = tab
